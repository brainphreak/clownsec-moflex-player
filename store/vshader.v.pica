; Store prototype vertex shader.
;
; Deliberately minimal: transform, pass the texcoord through, and pass a per-vertex shade
; value along as the vertex colour. The PICA200 has no fragment shaders -- only texture
; combiners -- so all "lighting" here is baked into the mesh at build time and simply
; multiplied against the texture in the combiner. That costs nothing per pixel, which is the
; whole point on a GPU where fill rate is the scarce resource.

.fvec projection[4], modelView[4]

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0      ; xyz position
.alias intex v1      ; uv
.alias inshd v2      ; x = shade (0..1), broadcast to rgb

.proc main
	; position -> clip space
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; texcoord straight through
	mov outtc0, intex

	; shade -> rgb, alpha 1
	mov r2.xyz, inshd.xxx
	mov r2.w,   ones
	mov outclr, r2

	end
.end
